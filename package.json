{
  "name": "chess-com",
  "version": "1.3.1",
  "description": "A wrapper to access information from the public chess.com API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "keywords": [
    "chess",
    "chess.com",
    "chesscom",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davipccunha/chess-com.git"
  },
  "author": "davipccunha",
  "scripts": {
    "build": "tsup",
    "patch": "npm version --no-git-tag-version -f patch && tsup && npm publish",
    "docs": "typedoc --plugin typedoc-plugin-rename-defaults"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typedoc": "^0.25.7",
    "typedoc-plugin-rename-defaults": "^0.7.0",
    "typescript": "^5.5.4"
  }
}
